#!/usr/bin/env bash

COMMAND="$1"
shift

if [ "$COMMAND" == "" ]; then
    echo "Error: command is missing"
    echo "Possible commands: "
    echo "- clean_tmp: delete content of testapp/temp"
    echo "- composer-install: install php packages"
    echo "- composer-update: update php packages"
    echo "- install: launch the installer of the application"
    echo "- init-data: setup initial accounts. To do after an installation"
    echo "- ldap-reset: delete and recreate ldap entries"
    echo "- ldap-shell: launch a shell into the ldap container"
    echo "- ldap-users: list of ldap entries"
    echo "- reset: delete all data and reinitialize configuration"
    echo "- reset-install: shortcut for  reset+install+init-data"
    echo "- rights: reinitialize rights on files"
    echo "- shell: launch a shell in the PHP container, as userphp user"
    echo "- shellroot: launch a shell in the PHP container, as root user"
    echo "- unit-tests: launch unit tests"
    exit 1;
fi
CONTAINER=jelix_saml_php

case $COMMAND in
    clean-tmp)
        docker exec -t -i $CONTAINER appctl.sh clean_tmp;;
    reset)
        docker exec -t -i $CONTAINER appctl.sh reset;;
    install)
        docker exec -t -i $CONTAINER appctl.sh install;;
    init-data)
        docker exec -t -i $CONTAINER appctl.sh init-data;;
    reset-install)
        docker exec -t -i $CONTAINER appctl.sh reset
        docker exec -t -i $CONTAINER appctl.sh install
        docker exec -t -i $CONTAINER appctl.sh init-data
        ;;
    rights)
        docker exec -t -i $CONTAINER appctl.sh rights;;
    composer-install)
        docker exec -t -i $CONTAINER appctl.sh composer_install;;
    composer-update)
        docker exec -t -i $CONTAINER appctl.sh composer_update;;
    unit-tests)
        docker exec -t -i $CONTAINER appctl.sh unit-tests $@
        ;;
    shell)
       docker exec -it --user userphp $CONTAINER  /bin/bash -l;;
    shellroot)
       docker exec -it $CONTAINER  /bin/sh  -l;;
    ldap-reset)
      docker exec -it jelix_saml_ldap /bin/ctl.sh reset
      ;;
    ldap-users)
       docker exec -it jelix_saml_ldap /bin/ctl.sh showusers
       ;;
    ldap-shell)
       docker exec -it jelix_saml_ldap  /bin/bash -l
     ;;
    *)
        echo "wrong command"
        exit 2
        ;;
esac
